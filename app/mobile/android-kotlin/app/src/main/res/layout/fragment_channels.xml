<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/channelsHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#131824"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Canale de Comunicare"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/channelsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Telegram card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#131824">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telegram Bot Integration"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchTelegram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:checked="true"
                            app:thumbTint="#00E5FF"
                            app:trackTint="#8892B0" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permite trimiterea și primirea de notificări via Telegram bot."
                        android:textColor="#8892B0"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Token Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bot API Token"
                        android:textColor="#5E6D8C"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/editTelegramToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#1C2434"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:inputType="textPassword"
                        android:hint="Introduceți token-ul Telegram"
                        android:textColorHint="#5E6D8C"
                        android:layout_marginBottom="10dp" />

                    <!-- Chat ID Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Target Chat ID (implicit)"
                        android:textColor="#5E6D8C"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/editTelegramChatId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#1C2434"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:inputType="text"
                        android:hint="ex: 123456789"
                        android:textColorHint="#5E6D8C"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveTelegram"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="end"
                        android:backgroundTint="#00E5FF"
                        android:text="Salvează"
                        android:textColor="#0A0D14"
                        android:textSize="12sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Discord card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#131824">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discord Webhook / Bot"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchDiscord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:checked="false"
                            app:thumbTint="#00E5FF"
                            app:trackTint="#8892B0" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sincronizează agenții cu canalele tale Discord."
                        android:textColor="#8892B0"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Webhook Input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Discord Webhook URL"
                        android:textColor="#5E6D8C"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/editDiscordWebhook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#1C2434"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:inputType="textUri"
                        android:hint="Introduceți webhook URL"
                        android:textColorHint="#5E6D8C"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnSaveDiscord"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_gravity="end"
                        android:backgroundTint="#1C2434"
                        android:text="Salvează"
                        android:textColor="#8892B0"
                        android:textSize="12sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WhatsApp card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#131824">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WhatsApp integration (Beta)"
                            android:textColor="#5E6D8C"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchWhatsapp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:checked="false"
                            android:enabled="false"
                            app:thumbTint="#5E6D8C"
                            app:trackTint="#1C2434" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control prin WhatsApp. Indisponibil în modul actual."
                        android:textColor="#5E6D8C"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
