<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/spatialHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#131824"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Spatial OS Control"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRefreshSpatial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh status"
            app:tint="#00E5FF" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/spatialHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- System Health Metrics Card -->
            <LinearLayout
                android:id="@+id/cardSystemHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STARE SISTEM &amp; SĂNĂTATE"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Grid of indicators -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gateway State"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtGatewayState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transport Connect"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtGatewayTransport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DeepSeek LLM"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtDeepseekStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remote Claude Code Agent"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtRemoteClaudeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtRemoteClaudeDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version: - | Mode: -"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RPC Router Readiness"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtGatewayRpc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BoardAI Published Map"
                            android:textColor="#8892B0"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtBoardaiStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="unknown"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </GridLayout>
            </LinearLayout>

            <!-- Active Plan Container -->
            <LinearLayout
                android:id="@+id/cardActivePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtPlanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Niciun Plan Activ"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlanObjective"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nu a fost creat niciun plan de execuție în Spatial OS."
                    android:textColor="#8892B0"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPlanStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="FĂRĂ PLAN"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnRunActivePlan"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#00E5FF"
                        android:text="RULEAZĂ PLAN"
                        android:textColor="#0A0D14"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Actions Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREARE PLAN RAPID"
                android:textColor="#5E6D8C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:id="@+id/gridQuickPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnCreateBoardSync"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="BoardAI Sync"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateDoctor"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="Doctor Diagnose"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateGatewayRestart"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="Restart Gateway"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateTypecheck"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="Typecheck"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateHostApi"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="Host API Test"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCreateBrowser"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#131824"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:text="Browser Test"
                    android:textStyle="bold" />
            </GridLayout>

            <!-- Approval Request Container -->
            <LinearLayout
                android:id="@+id/cardApprovalRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Solicitare Aprobare Pas"
                    android:textColor="#FFA726"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtApprovalStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nume Pas"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtApprovalStepDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Detalii execuție comandă..."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btnRejectStep"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#EF5350"
                        android:text="Respinge"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnApproveStep"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#66BB6A"
                        android:text="Aprobă"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stepper Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAȘI PLAN"
                android:textColor="#5E6D8C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutPlanSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                
                <TextView
                    android:id="@+id/txtNoSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Niciun pas configurat."
                    android:textColor="#8892B0"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="12dp"/>
            </LinearLayout>

            <!-- Agent Harness Container -->
            <LinearLayout
                android:id="@+id/cardAgentHarness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARNES AGENȚI CLUSTER"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutAgentHarness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNoAgents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Se încarcă agenții clusterului..."
                        android:textColor="#8892B0"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Kanban Tasks Container -->
            <LinearLayout
                android:id="@+id/cardKanban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="TABLOU KANBAN"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddTask"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="#00E5FF"
                        android:text="+ ADAUGĂ TASK"
                        android:textColor="#0A0D14"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp" />
                </RelativeLayout>

                <!-- Column switch selector (tabs) -->
                <RadioGroup
                    android:id="@+id/layoutKanbanTabs"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:background="#1C2434"
                    android:layout_marginBottom="12dp"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/rbTodo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:text="DE FĂCUT (0)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbInProgress"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:text="ÎN LUCRU (0)"
                        android:textColor="#8892B0"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbDone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:button="@android:color/transparent"
                        android:gravity="center"
                        android:text="FINALIZAT (0)"
                        android:textColor="#8892B0"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/layoutKanbanTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNoTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nu există task-uri în această secțiune."
                        android:textColor="#8892B0"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Real-time Console logs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="TASK EXECUTION PANEL"
                        android:textColor="#5E6D8C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">
                        <CheckBox
                            android:id="@+id/chkAutoScroll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-scroll"
                            android:textColor="#8892B0"
                            android:textSize="10sp"
                            android:checked="true" />
                        <Button
                            android:id="@+id/btnClearLog"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="CLEAR"
                            android:backgroundTint="#2C3545"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- Status & Step Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status:"
                        android:textColor="#8892B0"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/txtExecStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" | Step:"
                        android:textColor="#8892B0"
                        android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                    <TextView
                        android:id="@+id/txtExecStep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="None"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollConsole"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#05070B"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/txtSpatialConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#4AF626"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:text="System ready.\n" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <ProgressBar
        android:id="@+id/progressSpatial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#00E5FF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
