<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#131824"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#8892B0"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnDetailBack"
            android:text="Task Details"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/detailHeader"
        app:layout_constraintBottom_toTopOf="@id/actionPanel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/detailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2E3C56"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="unknown"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Logs:"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/detailLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#131824"
                android:padding="12dp"
                android:textColor="#AAB8C2"
                android:textSize="12sp"
                android:typeface="monospace"
                android:minHeight="100dp"
                android:layout_marginBottom="16dp" />

            <!-- Patch Data Container -->
            <LinearLayout
                android:id="@+id/patchContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patch Proposal"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPlannerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAB8C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvExecutorValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAB8C2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRiskValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFCA28"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvFilesChangedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <!-- Diff viewer wrapped in horizontal scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#131824"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/tvDiffPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:textColor="#AAB8C2"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        android:maxHeight="300dp" />
                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Panel (for Approve/Cancel) -->
    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#131824"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnCancelTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnRejectPatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reject"
            android:backgroundTint="#FF5252"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnRetryTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Retry"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnApproveTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Commit"
            android:backgroundTint="#00E5FF"
            android:textColor="#0A0D14"
            android:visibility="gone"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnApplyPatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apply Patch"
            android:backgroundTint="#66BB6A"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
