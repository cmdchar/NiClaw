<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1C2434"
    android:padding="10dp"
    android:layout_marginVertical="4dp"
    android:gravity="center_vertical"
    android:weightSum="1">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPhaseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Phase Name" />

        <TextView
            android:id="@+id/txtPhaseCron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8892B0"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:text="* * * * *" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/badgePhaseEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#131824"
            android:textColor="#00E5FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="ENABLED" />

        <TextView
            android:id="@+id/txtPhaseNextRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8892B0"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:text="Next run: --" />
    </LinearLayout>
</LinearLayout>
