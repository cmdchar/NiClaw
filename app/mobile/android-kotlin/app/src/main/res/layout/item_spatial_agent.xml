<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#131824"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Name and Model Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/spatialAgentSwitch">

                <TextView
                    android:id="@+id/spatialAgentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nume Agent"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/spatialAgentModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="model: zai-org/GLM-5.1-FP8"
                    android:textColor="#8892B0"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Switch and Status Badge -->
            <LinearLayout
                android:id="@+id/spatialAgentSwitchContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/spatialAgentStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:backgroundTint="#00E5FF11"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="ACTIVE"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/spatialAgentSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/Widget.AppCompat.CompoundButton.Switch" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Current Task section -->
        <TextView
            android:id="@+id/spatialAgentTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Task activ: Așteaptă comenzi..."
            android:textColor="#C3C9D6"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
