<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Horizontal Agent Selector -->
    <HorizontalScrollView
        android:id="@+id/agentSelectorScroll"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#131824"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnOpenClaw"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="OpenClaw"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnOpenHuman"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="OpenHuman"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnHermes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="Hermes"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnOpenCode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="VS Code"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnGemini"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="Gemini"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            <Button
                android:id="@+id/btnBoardAi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#1C2434"
                android:text="BoardAI"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Browser Controls Bar -->
    <LinearLayout
        android:id="@+id/browserControlsBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1A2030"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toBottomOf="@id/agentSelectorScroll">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#8892B0" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="#8892B0" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#8892B0" />

        <!-- Address input layout with secure icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="#131824"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/secureIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_secure"
                app:tint="#4CAF50"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/urlAddressInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:inputType="textUri"
                android:maxLines="1"
                android:imeOptions="actionGo"
                android:hint="Adresa URL..."
                android:textColorHint="#5E6D8C" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCopyUrl"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save"
            android:tooltipText="Copy URL"
            app:tint="#8892B0" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_silent_mode"
            app:tint="#8892B0" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_zoom"
            app:tint="#8892B0" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#8892B0"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_add"
            app:tint="#8892B0" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boardStatusBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#171D2B"
        android:paddingHorizontal="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/browserControlsBar">

        <TextView
            android:id="@+id/boardStatusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="BoardAI status: neincarcat"
            android:textColor="#C8D2F0"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnBoardStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#26324A"
            android:text="Status"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <Button
            android:id="@+id/btnBoardSync"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#26324A"
            android:text="Publish"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
    </LinearLayout>

    <!-- Web Progress Bar -->
    <ProgressBar
        android:id="@+id/webProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/boardStatusBar" />

    <!-- Webview -->
    <WebView
        android:id="@+id/portalWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/webProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
