<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#131824"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title & Status Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/agentActionRow">

                <TextView
                    android:id="@+id/agentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nume Agent"
                    android:textColor="#00E5FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agentSlug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="slug: supreme_orchestrator"
                    android:textColor="#5E6D8C"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:id="@+id/agentActionRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnEditAgent"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#00E5FF" />

                <ImageButton
                    android:id="@+id/btnDeleteAgent"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FF5252" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C2434"
            android:layout_marginVertical="10dp" />

        <!-- Role description -->
        <TextView
            android:id="@+id/agentRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rol: Supreme Orchestrator coordinates agent behaviors."
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Footer parameters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#8892B0"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/agentModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Model: gemini-1.5-pro"
                android:textColor="#8892B0"
                android:textSize="12sp" />

            <!-- Active Status Badge -->
            <TextView
                android:id="@+id/agentStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:drawable/dialog_holo_dark_frame"
                android:backgroundTint="#00E5FF22"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="ACTIVE"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
