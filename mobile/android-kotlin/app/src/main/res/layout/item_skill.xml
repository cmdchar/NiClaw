<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#131824"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Icon container -->
        <TextView
            android:id="@+id/txtSkillIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="#1C2434"
            android:gravity="center"
            android:text="🧩"
            android:textSize="20sp" />

        <!-- Info container -->
        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/txtSkillIcon"
            android:layout_toStartOf="@id/switchEnabled"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtSkillName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nume Skill"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSkillVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#2E3748"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="v1.0.0"
                    android:textColor="#8892B0"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtSkillDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Descriere skill pentru asistentul inteligent."
                android:textColor="#8892B0"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtSkillSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1C2434"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="BUNDLED"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Toggle Switch -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:thumbTint="#00E5FF"
            app:trackTint="#8892B0" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
